{
  "name": "agent-dashboard",
  "version": "4.9.0-rc1",
  "main": "index.js",
  "scripts": {
    "test": "pnpm run test:scripts && pnpm run test:boundaries && pnpm run test:unit && pnpm run test:smoke",
    "test:scripts": "node scripts/check-package-scripts.mjs",
    "test:boundaries": "node scripts/check-open-core-boundaries.mjs",
    "test:smoke": "node scripts/test-smoke.mjs",
    "test:unit": "node --test test/budget.test.mjs test/plan.test.mjs test/policy.test.mjs test/scripts.test.mjs",
    "test:regression": "pnpm run test:regression:plan_merge && pnpm run test:regression:danger_gating",
    "test:regression:plan_merge": "node --test test/plan.test.mjs",
    "test:regression:danger_gating": "node --test test/policy.test.mjs",
    "build": "vite build --config ui/vite.config.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "predev": "pnpm -s build:ui",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "audit:open": "node scripts/audit_open_release.mjs",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "minimatch": "^10.0.1",
    "node-pty": "^1.1.0",
    "openai": "^6.16.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.19.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wscat": "^6.1.0"
  },
  "type": "module"
}
